{
  "name": "aivio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:emulator": "firebase emulators:exec --only auth,firestore --project demo-aivio 'node --test --test-concurrency=1 \"tests/emulator/*.test.ts\"'",
    "test": "npm run test:unit && npm run test:emulator"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
