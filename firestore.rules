rules_version = '2';

// Aivio Firestore security rules.
//
// Default-deny: anything not matched below is refused. A learner can only
// touch their own users/{uid} document and username reservations they own.
// Paste into Firebase Console > Firestore Database > Rules > Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Exactly the fields src/lib/userProfile.ts writes. hasOnly() rejects any
    // extra key, so a tampered client cannot smuggle in fields of its own.
    function hasOnlyProfileFields() {
      return request.resource.data.keys().hasOnly([
        'uid', 'email', 'displayName', 'username', 'bio', 'location',
        'grade', 'school', 'birthday', 'website', 'avatarUrl',
        'dailyGoalXP', 'createdAt', 'updatedAt', 'schemaVersion'
      ]);
    }

    function isValidUsernameValue(name) {
      return name is string
        && (name == '' || name.matches('^[a-z0-9_]{3,20}$'));
    }

    // A non-empty username is only accepted when a reservation document with
    // that exact ID exists AND belongs to this user. This is what stops a
    // learner writing a name someone else holds by editing the client.
    function ownsUsernameReservation(name) {
      return name == ''
        || (
          exists(/databases/$(database)/documents/usernames/$(name))
          && get(/databases/$(database)/documents/usernames/$(name)).data.uid == request.auth.uid
        );
    }

    function isWellFormedProfile(userId) {
      return hasOnlyProfileFields()
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && isValidUsernameValue(request.resource.data.username)
        && ownsUsernameReservation(request.resource.data.username)
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 100
        && request.resource.data.grade is string
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 120
        && request.resource.data.birthday is string
        && request.resource.data.website is string
        && request.resource.data.website.size() <= 200
        && request.resource.data.avatarUrl is string
        && request.resource.data.dailyGoalXP is int
        && request.resource.data.dailyGoalXP >= 0
        && request.resource.data.dailyGoalXP <= 1000
        && request.resource.data.schemaVersion is int
        && request.resource.data.updatedAt is timestamp;
    }

    // Exactly the fields src/lib/progressStore.ts writes (UserProgress plus
    // schemaVersion/updatedAt). Required AND exclusive: nothing missing, nothing extra.
    function isWellFormedProgress() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'userName', 'totalXP', 'currentStreak', 'lastActiveDate',
          'completedLessonIds', 'earnedBadgeIds', 'lessonAttempts',
          'activePathId', 'schemaVersion', 'updatedAt',
          'revision', 'recentWriteIds'
        ])
        && d.keys().hasAll([
          'userName', 'totalXP', 'currentStreak', 'lastActiveDate',
          'completedLessonIds', 'earnedBadgeIds', 'lessonAttempts',
          'activePathId', 'schemaVersion', 'updatedAt',
          'revision', 'recentWriteIds'
        ])
        && d.userName is string && d.userName.size() >= 1 && d.userName.size() <= 60
        && d.totalXP is int && d.totalXP >= 0 && d.totalXP <= 1000000
        && d.currentStreak is int && d.currentStreak >= 0 && d.currentStreak <= 100000
        && d.lastActiveDate is string && d.lastActiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.completedLessonIds is list && d.completedLessonIds.size() <= 200
        && d.earnedBadgeIds is list && d.earnedBadgeIds.size() <= 100
        && d.lessonAttempts is map && d.lessonAttempts.size() <= 200
        && d.activePathId is string && d.activePathId.size() >= 1 && d.activePathId.size() <= 100
        && d.schemaVersion is int && d.schemaVersion == 1
        && d.revision is int && d.revision >= 1
        && d.recentWriteIds is list && d.recentWriteIds.size() <= 20
        && d.updatedAt == request.time;
    }

    // ── Social: public profiles, friend requests, friendships ──

    // The ONLY fields other learners can ever see about someone. Email, bio,
    // location, school, birthday, progress and every other private field live
    // in users/{uid} and never appear here.
    function isWellFormedPublicProfile(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'displayName', 'username', 'avatarUrl', 'schemaVersion', 'updatedAt'])
        && d.keys().hasAll(['uid', 'displayName', 'username', 'avatarUrl', 'schemaVersion', 'updatedAt'])
        && d.uid == userId
        && d.displayName is string && d.displayName.size() <= 60
        && isValidUsernameValue(d.username)
        // The shown username must be one this learner has reserved, so nobody
        // can publish a name that belongs to someone else.
        && ownsUsernameReservation(d.username)
        // Avatars are the app's own bundled images, never an arbitrary URL
        // that would leak viewers' IP addresses to a third party.
        && d.avatarUrl is string && d.avatarUrl.matches('^/mascot-[a-z0-9-]{1,40}[.](png|jpg)$')
        && d.schemaVersion is int && d.schemaVersion == 1
        && d.updatedAt == request.time;
    }

    // Both orders of a pair map to one friendship document ID.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function publicProfilePath(uid) {
      return /databases/$(database)/documents/publicProfiles/$(uid);
    }

    // A pair of people shares exactly ONE request document, whichever of them
    // sent it. Two crossing requests therefore collide on the same document ID
    // and the second is refused by the database itself, not by a racy check.
    function requestPath(a, b) {
      return /databases/$(database)/documents/friendRequests/$(pairId(a, b));
    }

    function friendshipPath(a, b) {
      return /databases/$(database)/documents/friendships/$(pairId(a, b));
    }

    match /users/{userId} {
      // Read only your own document. `list` stays denied, so the user
      // collection cannot be enumerated even by a signed-in learner.
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isWellFormedProfile(userId)
        && request.resource.data.createdAt is timestamp
        // The stored email must match the verified token claim, so nobody can
        // write someone else's address onto their own profile.
        && request.resource.data.email == request.auth.token.email;

      allow update: if isOwner(userId)
        && isWellFormedProfile(userId)
        // Identity fields are immutable after creation. Email changes belong
        // to Firebase Auth, not to a client-side profile edit.
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      // Account deletion should go through a reviewed server-side flow.
      allow delete: if false;

      // Learning progress: one document per learner at users/{uid}/progress/state.
      // Sub-collections do not inherit the parent's rules, so this is explicit.
      match /progress/{progressId} {
        allow get: if isOwner(userId) && progressId == 'state';
        allow list: if false;
        // `revision` must advance by exactly one per write. A client holding a
        // stale copy therefore cannot silently replace a newer document; the
        // app writes through a transaction that re-reads and merges first.
        // Documents written before revisions existed count as revision 0.
        allow create: if isOwner(userId)
          && progressId == 'state'
          && isWellFormedProgress()
          && request.resource.data.revision == 1;
        allow update: if isOwner(userId)
          && progressId == 'state'
          && isWellFormedProgress()
          && request.resource.data.revision == resource.data.get('revision', 0) + 1;
        allow delete: if false;
      }
    }

    // Discovery data. Readable by any signed-in learner (that is its purpose);
    // writable only by its owner. list is capped so the whole directory cannot
    // be pulled in a single query.
    match /publicProfiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 50;
      allow create, update: if isOwner(userId) && isWellFormedPublicProfile(userId);
      allow delete: if false;
    }

    // friendRequests/{smallerUid}_{largerUid}: one document per pair of people,
    // holding who asked whom. Existence means "pending"; accepting or declining
    // deletes it. Only the two people involved can see it, and list queries
    // must filter by their own UID.
    match /friendRequests/{requestId} {
      // `get` is decided from the document ID (it contains both UIDs) so that
      // checking a request that does not exist yet is allowed for the two
      // people it would belong to, and refused for everyone else.
      allow get: if isSignedIn()
        && (requestId.split('_')[0] == request.auth.uid || requestId.split('_')[1] == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['fromUid', 'toUid', 'createdAt'])
        // The sender is always the authenticated user, never a client claim.
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == pairId(request.auth.uid, request.resource.data.toUid)
        && request.resource.data.createdAt == request.time
        // Both people must be real, discoverable accounts.
        && exists(publicProfilePath(request.auth.uid))
        && exists(publicProfilePath(request.resource.data.toUid))
        // None between people who are already friends.
        && !exists(friendshipPath(request.auth.uid, request.resource.data.toUid));

      // Never updatable: a second create on an existing pair (a duplicate, or
      // the other person's crossing request) is evaluated as an update.
      allow update: if false;

      // The sender cancels; the recipient declines. Nobody else can delete.
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // friendships/{smallerUid}_{largerUid}. One document represents the
    // friendship for both people. It can only be created by the person who
    // RECEIVED a request, in the same batch that deletes that request, so a
    // friendship cannot be forced on anyone.
    match /friendships/{pair} {
      allow get: if isSignedIn()
        && (pair.split('_')[0] == request.auth.uid || pair.split('_')[1] == request.auth.uid);
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.keys().hasAll(['members', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pair == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt == request.time
        // A pending request FROM the other person TO me must exist now...
        && get(requestPath(request.resource.data.members[0], request.resource.data.members[1])).data.toUid == request.auth.uid
        && get(requestPath(request.resource.data.members[0], request.resource.data.members[1])).data.fromUid
             == (request.resource.data.members[0] == request.auth.uid
                  ? request.resource.data.members[1] : request.resource.data.members[0])
        // ...and must be consumed by this same batch.
        && !existsAfter(requestPath(request.resource.data.members[0], request.resource.data.members[1]));

      allow update: if false;

      // Either friend can end the friendship.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;
    }

    // Username reservations. The document ID *is* the normalized username, so
    // Firestore's one-document-per-ID guarantee is what enforces uniqueness.
    match /usernames/{username} {
      // A signed-in learner may check whether one specific name is free.
      // list stays denied, so the full directory cannot be harvested.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && username.matches('^[a-z0-9_]{3,20}$');

      // Never updatable: a create against an existing document is evaluated
      // as an update, so the second claimant of a name is always rejected.
      allow update: if false;

      // Only the holder may release their own name.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Everything else is denied, including collections added later that have
    // not been given explicit rules here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
