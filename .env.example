# Firebase web app config — copy this file to .env.local and fill in the values
# from Firebase Console > Project settings > General > Your apps > Web app.
# These values ship in the client bundle and are not secrets; Firestore
# security rules and API key domain restrictions are what protect the project.
# Never put an Admin SDK service account key in this file or anywhere in src/.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
